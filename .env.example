# ===== 应用 =====
APP_NAME=i2v-platform
# 生产使用 APP_ENV=production，关闭 DEBUG、SQL_ECHO 和 MOCK_WORKER。
# 使用独立的生产凭据、预置 Fernet 密钥及真实 HTTPS 审核端点。
APP_ENV=local
DEBUG=true
SQL_ECHO=false

# ===== MySQL =====
# 本机 3306 已被原生 MySQL 服务占用，端口顺延为 13306
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=i2v_platform
MYSQL_USER=i2v
MYSQL_PASSWORD=i2v_pwd_2026
MYSQL_ROOT_PASSWORD=root_pwd_2026

# ===== Redis =====
# 本机 6379 已被原生 Redis 服务占用，端口顺延为 16379
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
REDIS_DB=0
REDIS_PASSWORD=

# ===== MinIO（9000/9001 本机空闲，保持默认）=====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_BUCKET_PUBLIC=i2v-public
MINIO_BUCKET_VIDEOS=i2v-videos
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 下载 CDN（留空=直接用 MinIO 端点；填了会把签名 URL 的 host 换掉）
CDN_BASE_URL=
# 成片下载签名有效期（秒，手册红线 1800）
DOWNLOAD_URL_TTL=1800

# ===== 安全 =====
# 本地为空时自动生成 Fernet 密钥；生产必须预置。已有加密数据沿用原密钥。
AES_FERNET_KEY=
# 初始密码可查看时长：168 小时 = 7 天（导入/重置后 7 天内可查看导出）
INIT_PWD_VIEW_HOURS=168
# bcrypt cost：10 时单次约 56ms，16 进程并行下 1000 个初始密码约 5.5~6.7s（Excel 导入 ≤10s 的关键）
BCRYPT_ROUNDS=10
# 批量哈希进程池 worker 数（0 = 按 CPU 自动，上限 16）
HASH_POOL_WORKERS=16
# 会话与登录保护
SESSION_TTL_SECONDS=86400
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=5
# 账号留空时自动生成规则：前缀 + 6 位递增序号（C2026000001）
AUTO_ACCOUNT_PREFIX=C2026
AUTO_ACCOUNT_DIGITS=6
# Excel 单次导入行数上限
EXCEL_IMPORT_MAX_ROWS=5000

# ===== 初始管理员（admins 表为空时创建）=====
ADMIN_INIT_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@2026!
ADMIN_INIT_PASSWORD=Admin@2026!

# ===== Mock Worker（同伴的真实 Worker 就绪后置 false）=====
MOCK_WORKER=true
MOCK_SUCCESS_RATE=0.8
MOCK_QUEUE_DELAY=1.0
MOCK_RUN_DELAY=1.0
# MOCK_WORKER=false 时，handoff_sync 调用的 Celery 任务入口
CELERY_TASK_MODULE=worker.tasks
CELERY_TASK_FUNC=enqueue_video_generation

# ===== 内容审核 =====
# 开发可用 mock；生产必须用 http 提供方并配置 HTTPS 审核端点（见 services/moderation.py）。
# 生产登录需要 HTTPS，可信反向代理应由 ASGI 服务器配置。
MODERATION_PROVIDER=mock
MODERATION_ENDPOINT=
MODERATION_TIMEOUT=10.0
